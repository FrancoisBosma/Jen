{
  "cSpell.words": [
    "automagically",
    "commitlint",
    "extrabold",
    "iconify",
    "intlify",
    "loglevel",
    "markdownlint",
    "maskable",
    "noopener",
    "nprogress",
    "Nuxt",
    "pinia",
    "pnpm",
    "postcss",
    "preinstall",
    "reactified",
    "seethrough",
    "stylelint",
    "Tinkerings",
    "unplugin",
    "vars",
    "Vite",
    "vitejs",
    "vitest",
    "vueuse"
  ],
  "cSpell.language": "en-GB",
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  }
}
